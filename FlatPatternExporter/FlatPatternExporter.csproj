<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.26100.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>FPExport.ico</ApplicationIcon>
    <LangVersion>12.0</LangVersion>
    <InventorInstallDir Condition="'$(InventorInstallDir)' == ''">$(ProgramW6432)\Autodesk\Inventor 2027</InventorInstallDir>
    <InventorInteropPath>$(InventorInstallDir)\Bin\Public Assemblies\Autodesk.Inventor.Interop.dll</InventorInteropPath>

    <StartupObject>FlatPatternExporter.App</StartupObject>

    <!-- Application metadata -->
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Company>mrTorch222</Company>
    <Authors>Sinicyn Ivan Victorovich; mrTorch222 (fork maintainer)</Authors>
    <AssemblyName>PatternExporterNX</AssemblyName>
    <RootNamespace>FlatPatternExporter</RootNamespace>
    <ProductEdition Condition="'$(ProductEdition)' == ''">Combined</ProductEdition>
    <RepositoryUrl>https://github.com/mrTorch222/PatternExporterNX</RepositoryUrl>
    <Description>Independent fork of isinicyn/FlatPatternExporter, maintained by mrTorch222.</Description>
    <Product>PatternExporterNX</Product>
    <Copyright>Copyright © 2025 Sinicyn Ivan Victorovich</Copyright>
    <AssemblyTitle>PatternExporterNX for Autodesk Inventor</AssemblyTitle>
    <NeutralLanguage>en-US</NeutralLanguage>
  </PropertyGroup>

  <PropertyGroup Condition="'$(ProductEdition)' == 'SheetMetal'">
    <DefineConstants>$(DefineConstants);PATTERN_EXPORTER_SHEET_METAL</DefineConstants>
    <AssemblyName>PatternExporterNX.SheetMetal</AssemblyName>
  </PropertyGroup>

  <PropertyGroup Condition="'$(ProductEdition)' == 'Frame'">
    <DefineConstants>$(DefineConstants);PATTERN_EXPORTER_FRAME</DefineConstants>
    <AssemblyName>PatternExporterNX.Frame</AssemblyName>
  </PropertyGroup>

  <Target Name="ValidateProductEdition" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(ProductEdition)' != 'Combined' and '$(ProductEdition)' != 'SheetMetal' and '$(ProductEdition)' != 'Frame'"
           Text="ProductEdition must be Combined, SheetMetal, or Frame." />
  </Target>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebugType>full</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
	  <DebugType>none</DebugType>
  </PropertyGroup>

<PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier> <!-- For x64 -->
</PropertyGroup>

  <PropertyGroup>
    <SourceRevisionId></SourceRevisionId>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <Target Name="SetVersionInfo" BeforeTargets="GetAssemblyVersion">
    <Exec Command="git rev-list --count HEAD" ConsoleToMSBuild="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="RevisionNumber" />
    </Exec>
    <Exec Command="git rev-parse --short=7 HEAD" ConsoleToMSBuild="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="CommitHash" />
    </Exec>
    <Exec Command="git log -1 --format=%%ci" ConsoleToMSBuild="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="CommitDateRaw" />
    </Exec>
    <PropertyGroup>
      <!-- Format: 2025-10-15 13:28:14 +0300 -> 15.10.2025 13:28:14 -->
      <CommitDate>$([System.DateTime]::Parse('$(CommitDateRaw)').ToString('dd.MM.yyyy HH:mm:ss'))</CommitDate>
    </PropertyGroup>
    <PropertyGroup>
      <VersionPrefix>3.1.0</VersionPrefix>
      <VersionSuffix>$(RevisionNumber)</VersionSuffix>
      <AssemblyVersion>$(VersionPrefix).$(VersionSuffix)</AssemblyVersion>
      <FileVersion>$(VersionPrefix).$(VersionSuffix)</FileVersion>
      <InformationalVersion>$(VersionPrefix).$(VersionSuffix) build:$(CommitHash)</InformationalVersion>
    </PropertyGroup>

    <!-- Add commit date as assembly metadata -->
    <ItemGroup>
      <AssemblyMetadata Include="CommitDate" Value="$(CommitDate)" />
    </ItemGroup>

    <!-- Add detailed logging -->
    <Message Text="VersionPrefix: $(VersionPrefix)" Importance="high" />
    <Message Text="VersionSuffix: $(VersionSuffix)" Importance="high" />
    <Message Text="RevisionNumber: $(RevisionNumber)" Importance="high" />
    <Message Text="CommitHash: $(CommitHash)" Importance="high" />
    <Message Text="CommitDate: $(CommitDate)" Importance="high" />
    <Message Text="Assembly Version: $(AssemblyVersion)" Importance="high" />
    <Message Text="File Version: $(FileVersion)" Importance="high" />
    <Message Text="Informational Version: $(InformationalVersion)" Importance="high" />
    <Message Text="SourceRevisionId: $(SourceRevisionId)" Importance="high" />
  </Target>

  <ItemGroup>
    <Resource Include="Resources\pic\5e4a4cfa-8411-4744-bd53-1f219e7ac097.png" />
    <Resource Include="Resources\pic\e93ee721-afa4-4021-9968-8472b1cd26b0.png" />
  </ItemGroup>


  <ItemGroup>
    <Resource Include="FPExport.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="Microsoft-WindowsAPICodePack-Shell" Version="1.1.5" />
    <PackageReference Include="netDxf.netstandard" Version="3.0.1" />
    <PackageReference Include="Svg.Skia" Version="3.2.1" />
    <PackageReference Include="stdole" Version="17.14.40260" />
  </ItemGroup>


  <ItemGroup>
    <Reference Include="Autodesk.Inventor.Interop">
      <Private>false</Private>
      <HintPath>$(InventorInteropPath)</HintPath>
    </Reference>
  </ItemGroup>
  <Target Name="ValidateInventorInterop" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(InventorInteropPath)')"
           Text="Inventor 2027 interop was not found at '$(InventorInteropPath)'. Install Autodesk Inventor 2027 or set -p:InventorInstallDir=&quot;C:\path\to\Inventor 2027&quot;." />
  </Target>
  

</Project>
