<Window x:Class="FlatPatternExporter.Features.Acceptance.UI.AcceptanceSheetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:extensions="clr-namespace:FlatPatternExporter.Extensions"
        xmlns:acceptance="clr-namespace:FlatPatternExporter.Features.Acceptance.Models"
        Title="{extensions:Localize Acceptance_Title}" Width="1480" Height="780" MinWidth="1180" MinHeight="650"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BackgroundPrimaryBrush}"
        Foreground="{DynamicResource TextSecondaryBrush}">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="310"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="330"/>
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0">
            <TextBlock DockPanel.Dock="Top" Text="{extensions:Localize Acceptance_Parts}" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <ListBox x:Name="PartsList" ItemsSource="{Binding Items}" SelectionChanged="PartsList_SelectionChanged"
                     SelectedIndex="0" HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Width="50" Height="45" Background="White">
                                <Image Source="{Binding Preview}" Stretch="Uniform"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="{Binding PartNumber}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Quantity, StringFormat=× {0}}"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border x:Name="PreviewSurface" Background="White" BorderBrush="{DynamicResource BorderPrimaryBrush}" BorderThickness="1"
                    Cursor="Hand" MouseLeftButtonDown="Preview_MouseLeftButtonDown" MouseMove="Preview_MouseMove"
                    MouseLeftButtonUp="Preview_MouseLeftButtonUp">
                <Grid>
                    <Image Source="{Binding SelectedItem.Preview}" Stretch="Uniform" Margin="20"/>
                    <TextBlock Text="{extensions:Localize Acceptance_DragHint}" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                               Margin="8" Foreground="#88000000"/>
                    <Border Background="#99000000" CornerRadius="4" Padding="12,7" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRendering}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{extensions:Localize Acceptance_Rendering}" Foreground="White"/>
                    </Border>
                </Grid>
            </Border>

            <StackPanel x:Name="CameraControls" Grid.Row="1" Margin="0,12,0,8">
                <WrapPanel VerticalAlignment="Center" Margin="0,0,0,8">
                    <Button Content="{extensions:Localize Acceptance_Iso}" Tag="IsoTopRight" Click="ViewPreset_Click" Margin="0,0,6,0"/>
                    <Button Content="{extensions:Localize Acceptance_Front}" Tag="Front" Click="ViewPreset_Click" Margin="0,0,6,0"/>
                    <Button Content="{extensions:Localize Acceptance_Top}" Tag="Top" Click="ViewPreset_Click" Margin="0,0,6,0"/>
                    <Button Content="{extensions:Localize Acceptance_Right}" Tag="Right" Click="ViewPreset_Click" Margin="0,0,12,0"/>
                    <Button Content="{extensions:Localize Acceptance_ResetView}" Click="ResetView_Click" Margin="0,0,12,0"/>
                    <Button Content="{extensions:Localize Acceptance_ApplyViewToAll}" Click="ApplyViewToAll_Click"/>
                </WrapPanel>
                <WrapPanel VerticalAlignment="Center" Margin="0,0,0,8">
                    <CheckBox Content="{extensions:Localize Acceptance_Perspective}" IsChecked="{Binding SelectedItem.Perspective}"
                              Checked="CameraOption_Changed" Unchecked="CameraOption_Changed" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Text="{extensions:Localize Acceptance_ViewAngle}" VerticalAlignment="Center"/>
                    <Slider Width="150" Minimum="10" Maximum="80" Value="{Binding SelectedItem.PerspectiveAngle}" Margin="8,0"
                            IsSnapToTickEnabled="True" TickFrequency="1" PreviewMouseLeftButtonUp="AngleSlider_MouseLeftButtonUp"/>
                    <TextBlock Text="{Binding SelectedItem.PerspectiveAngle, StringFormat={}{0:F0}°}" VerticalAlignment="Center" Width="42"/>
                    <Button Content="{extensions:Localize Acceptance_NextPart}" Click="NextPart_Click" Margin="12,0,0,0"/>
                </WrapPanel>
                <WrapPanel VerticalAlignment="Center">
                    <TextBlock Text="{extensions:Localize Acceptance_Paper}" VerticalAlignment="Center"/>
                    <ComboBox ItemsSource="{Binding PaperSizeOptions}" SelectedItem="{Binding Settings.PaperSize}" Width="65" Margin="6,0,12,0"/>
                    <CheckBox Content="{extensions:Localize Acceptance_Landscape}" IsChecked="{Binding Settings.Landscape}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Text="{extensions:Localize Acceptance_CardsPerRow}" VerticalAlignment="Center"/>
                    <ComboBox ItemsSource="{Binding CardsPerRowOptions}" SelectedItem="{Binding Settings.CardsPerRow}" Width="50" Margin="6,0,12,0"/>
                </WrapPanel>
            </StackPanel>

            <DockPanel Grid.Row="2">
                <TextBlock Text="{Binding Status}" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{extensions:Localize Acceptance_RefreshAll}" Click="RefreshAll_Click" IsEnabled="{Binding CanExport}" Margin="0,0,8,0"/>
                    <Button Content="{extensions:Localize Acceptance_Export}" Click="Export_Click" IsEnabled="{Binding CanExport}" Margin="0,0,8,0"/>
                    <Button Content="{extensions:Localize Button_Close}" Click="Close_Click"/>
                </StackPanel>
            </DockPanel>
        </Grid>

        <GroupBox Grid.Column="4" Header="{extensions:Localize Acceptance_CardDesigner}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="10">
                    <TextBlock Text="{extensions:Localize Acceptance_Layout}"/>
                    <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding Settings.ImagePlacement}" Margin="0,4,0,10">
                        <ComboBoxItem Tag="{x:Static acceptance:AcceptanceImagePlacement.Left}" Content="{extensions:Localize Acceptance_ImageLeft}"/>
                        <ComboBoxItem Tag="{x:Static acceptance:AcceptanceImagePlacement.Top}" Content="{extensions:Localize Acceptance_ImageTop}"/>
                    </ComboBox>
                    <TextBlock Text="{extensions:Localize Acceptance_Border}"/>
                    <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding Settings.BorderWeight}" Margin="0,4,0,10">
                        <ComboBoxItem Tag="{x:Static acceptance:AcceptanceBorderWeight.Thin}" Content="{extensions:Localize Acceptance_BorderThin}"/>
                        <ComboBoxItem Tag="{x:Static acceptance:AcceptanceBorderWeight.Medium}" Content="{extensions:Localize Acceptance_BorderMedium}"/>
                        <ComboBoxItem Tag="{x:Static acceptance:AcceptanceBorderWeight.Thick}" Content="{extensions:Localize Acceptance_BorderThick}"/>
                    </ComboBox>
                    <CheckBox Content="{extensions:Localize Acceptance_ShowFieldLabels}" IsChecked="{Binding Settings.ShowFieldLabels}" Margin="0,0,0,10"/>
                    <TextBlock Text="{extensions:Localize Acceptance_QuantitySize}"/>
                    <Slider Minimum="18" Maximum="48" TickFrequency="2" IsSnapToTickEnabled="True"
                            Value="{Binding Settings.QuantityFontSize}" Margin="0,4,0,10"/>

                    <TextBlock Text="{extensions:Localize Acceptance_Fields}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <ItemsControl ItemsSource="{Binding Settings.Fields}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsVisible}" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" Margin="6,0"/>
                                    <Button Grid.Column="2" Content="↑" Tag="{Binding}" Click="MoveFieldUp_Click" Width="28"/>
                                    <Button Grid.Column="3" Content="↓" Tag="{Binding}" Click="MoveFieldDown_Click" Width="28" Margin="3,0,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{extensions:Localize Acceptance_CardPreview}" FontWeight="SemiBold" Margin="0,16,0,6"/>
                    <Border Background="White" BorderBrush="Black" Padding="5" Height="245">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderThickness" Value="2"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Settings.BorderWeight}" Value="{x:Static acceptance:AcceptanceBorderWeight.Thin}"><Setter Property="BorderThickness" Value="1"/></DataTrigger>
                                    <DataTrigger Binding="{Binding Settings.BorderWeight}" Value="{x:Static acceptance:AcceptanceBorderWeight.Thick}"><Setter Property="BorderThickness" Value="3"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                            <Border Background="#FFF7F7F7" BorderBrush="#FFBBBBBB" BorderThickness="0,0,1,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Grid.RowSpan" Value="2"/><Setter Property="Grid.Column" Value="0"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Settings.ImagePlacement}" Value="{x:Static acceptance:AcceptanceImagePlacement.Top}">
                                                <Setter Property="Grid.ColumnSpan" Value="2"/><Setter Property="Grid.RowSpan" Value="1"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Image Source="{Binding SelectedItem.Preview}" Stretch="Uniform" Margin="5"/>
                            </Border>
                            <StackPanel Margin="7">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Grid.Column" Value="1"/><Setter Property="Grid.RowSpan" Value="2"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Settings.ImagePlacement}" Value="{x:Static acceptance:AcceptanceImagePlacement.Top}">
                                                <Setter Property="Grid.Column" Value="0"/><Setter Property="Grid.ColumnSpan" Value="2"/><Setter Property="Grid.Row" Value="1"/><Setter Property="Grid.RowSpan" Value="1"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <ItemsControl ItemsSource="{Binding Settings.Fields}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <TextBlock Foreground="Black" TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding IsVisible}" Value="True"/>
                                                                        <Condition Binding="{Binding DataContext.Settings.ShowFieldLabels, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                    <Run Text="{Binding Label}"/><Run Text=": "/><Run Text="{Binding PreviewValue}"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding PreviewValue}" Foreground="Black" TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding IsVisible}" Value="True"/>
                                                                        <Condition Binding="{Binding DataContext.Settings.ShowFieldLabels, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding SelectedItem.Quantity}" Foreground="Black" FontWeight="Bold" HorizontalAlignment="Center">
                                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="FontSize" Value="{Binding Settings.QuantityFontSize}"/></Style></TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </GroupBox>
    </Grid>
</Window>
