<UserControl x:Class="FlatPatternExporter.Features.Frame.UI.FrameExporterControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:extensions="clr-namespace:FlatPatternExporter.Extensions"
             Background="{DynamicResource BackgroundPrimaryBrush}"
             Foreground="{DynamicResource TextSecondaryBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0" Margin="{StaticResource OuterTopMarginThickness}">
            <Button x:Name="ScanFrameButton" Content="{extensions:Localize Frame_ButtonScan}" Click="ScanFrameButton_Click"
                    Style="{StaticResource LargeSquareButtonStyle}" Margin="{StaticResource RightStandardMarginThickness}"/>
            <Button x:Name="Export3dButton" Content="{extensions:Localize Frame_ButtonExport3d}" Click="Export3dButton_Click"
                    Style="{StaticResource LargeSquareButtonStyle}" Margin="{StaticResource RightStandardMarginThickness}" IsEnabled="False"/>
            <Button x:Name="ExportBomButton" Content="{extensions:Localize Frame_ButtonExportBom}" Click="ExportBomButton_Click"
                    Style="{StaticResource LargeSquareButtonStyle}" Margin="{StaticResource RightStandardMarginThickness}" IsEnabled="False"/>
            <Button Content="{extensions:Localize Button_Clear}" Click="ClearButton_Click"
                    Style="{StaticResource LargeSquareButtonStyle}"/>
        </WrapPanel>

        <Expander Grid.Row="1" Header="{extensions:Localize Header_Settings}" IsExpanded="True"
                  Margin="{StaticResource StandardPaddingThickness}" Padding="{StaticResource UniformSmallPaddingThickness}"
                  FlowDirection="RightToLeft" Style="{StaticResource SquareExpanderStyle}">
        <Border Background="{DynamicResource BackgroundTertiaryBrush}" FlowDirection="LeftToRight"
                BorderBrush="{DynamicResource BorderSecondaryBrush}" BorderThickness="1" CornerRadius="3"
                Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="360"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="150"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="{extensions:Localize Frame_LabelOutputFolder}" VerticalAlignment="Center" Margin="0,0,8,6"/>
                <TextBox x:Name="OutputFolderTextBox" Grid.Row="0" Grid.Column="1" Margin="0,0,8,6"/>
                <Button Grid.Row="0" Grid.Column="2" Content="..." Click="BrowseOutputFolder_Click" Width="34" Margin="0,0,16,6"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="{extensions:Localize Frame_LabelNameTemplate}" VerticalAlignment="Center" Margin="0,0,8,6"/>
                <TextBox x:Name="NameTemplateTextBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                         TextChanged="NameTemplateTextBox_TextChanged" Margin="0,0,16,6"/>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="{extensions:Localize Text_Preview}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock x:Name="NamePreviewTextBlock" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>

                <TextBlock Grid.Row="0" Grid.Column="3" Grid.ColumnSpan="3" Text="{extensions:Localize Frame_TokensHint}"
                           TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                <StackPanel Grid.Row="2" Grid.Column="3" Orientation="Horizontal" Margin="0,0,16,0">
                    <TextBlock Text="{extensions:Localize Frame_LabelFormat}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="ExportFormatComboBox" Width="100" SelectedIndex="0" SelectionChanged="ExportFormatComboBox_SelectionChanged">
                        <ComboBoxItem Content="IGES"/>
                        <ComboBoxItem Content="STEP"/>
                        <ComboBoxItem Content="SAT"/>
                        <ComboBoxItem Content="STL"/>
                    </ComboBox>
                </StackPanel>
                <WrapPanel x:Name="IgesOptionsPanel" Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="3">
                <StackPanel Orientation="Horizontal" Margin="0,0,16,6">
                    <TextBlock Text="{extensions:Localize Frame_LabelGeometryType}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="GeometryTypeComboBox" Width="120" SelectedIndex="0">
                        <ComboBoxItem Content="{extensions:Localize Frame_GeometrySurfaces}"/>
                        <ComboBoxItem Content="{extensions:Localize Frame_GeometrySolids}"/>
                        <ComboBoxItem Content="{extensions:Localize Frame_GeometryWireframe}"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,16,6">
                    <TextBlock Text="{extensions:Localize Frame_LabelSolidFaces}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="SolidFaceTypeComboBox" Width="100" SelectedIndex="1">
                        <ComboBoxItem Content="{extensions:Localize Frame_FacesNurbs}"/>
                        <ComboBoxItem Content="{extensions:Localize Frame_FacesAnalytic}"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="{extensions:Localize Frame_LabelSurfaces}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="SurfaceTypeComboBox" Width="90" SelectedIndex="1">
                        <ComboBoxItem Content="IGES 143"/>
                        <ComboBoxItem Content="IGES 144"/>
                    </ComboBox>
                </StackPanel>
                </WrapPanel>

                <WrapPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="6" Margin="0,8,0,0">
                    <TextBlock Text="{extensions:Localize Frame_TokensHint}" VerticalAlignment="Center" Margin="0,0,8,4"/>
                    <Button Content="{}{PartNumber}" Tag="{}{PartNumber}" Click="NameTokenButton_Click" Margin="0,0,4,4"/>
                    <Button Content="{}{StockNumber}" Tag="{}{StockNumber}" Click="NameTokenButton_Click" Margin="0,0,4,4"/>
                    <Button Content="{}{Material}" Tag="{}{Material}" Click="NameTokenButton_Click" Margin="0,0,4,4"/>
                    <Button Content="{}{Description}" Tag="{}{Description}" Click="NameTokenButton_Click" Margin="0,0,4,4"/>
                    <Button Content="{}{Length}" Tag="{}{Length}" Click="NameTokenButton_Click" Margin="0,0,4,4"/>
                    <Button Content="{}{Qty}" Tag="{}{Qty}" Click="NameTokenButton_Click" Margin="0,0,4,4"/>
                    <Button Content="{}{FileName}" Tag="{}{FileName}" Click="NameTokenButton_Click" Margin="0,0,12,4"/>
                    <TextBox x:Name="CustomNameTextBox" Width="130" ToolTip="{extensions:Localize ToolTip_EnterCustomText}" Margin="0,0,4,4"/>
                    <Button Content="+" Click="AddCustomNameTextButton_Click" ToolTip="{extensions:Localize ToolTip_AddCustomToken}" Width="28" Margin="0,0,4,4"/>
                </WrapPanel>

                <WrapPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="6" Margin="0,4,0,0">
                    <TextBlock Text="{extensions:Localize Header_TemplatePresets}" VerticalAlignment="Center" Margin="0,0,8,4"/>
                    <ComboBox x:Name="FramePresetComboBox" Width="180" DisplayMemberPath="Name"
                              SelectionChanged="FramePresetComboBox_SelectionChanged" Margin="0,0,4,4"/>
                    <TextBox x:Name="FramePresetNameTextBox" Width="140" ToolTip="{extensions:Localize ToolTip_PresetName}" Margin="0,0,4,4"/>
                    <Button Content="+" Click="CreateFramePresetButton_Click" ToolTip="{extensions:Localize ToolTip_CreatePreset}" Width="30" Margin="0,0,4,4"/>
                    <Button Content="{extensions:Localize Button_Save}" Click="UpdateFramePresetButton_Click" ToolTip="{extensions:Localize ToolTip_SavePreset}" Margin="0,0,4,4"/>
                    <Button Content="×" Click="DeleteFramePresetButton_Click" ToolTip="{extensions:Localize ToolTip_DeletePreset}" Width="30" Margin="0,0,4,4"/>
                </WrapPanel>
            </Grid>
        </Border>
        </Expander>

        <DataGrid x:Name="FrameMembersGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" SelectionMode="Extended" AlternationCount="2"
                  SelectionChanged="FrameMembersGrid_SelectionChanged"
                  Background="{DynamicResource BackgroundPrimaryBrush}"
                  BorderBrush="{DynamicResource BorderPrimaryBrush}" BorderThickness="1"
                  RowStyle="{StaticResource DataGridRowStyle}"
                  ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                  CellStyle="{StaticResource DataGridCellStyle}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{extensions:Localize Property_ProcessingStatus_ColumnHeader}" Binding="{Binding ProcessingStatusText}" SortMemberPath="ProcessingStatus"/>
                <DataGridTextColumn Header="{extensions:Localize Property_PartNumber_ColumnHeader}" Binding="{Binding PartNumber}" SortMemberPath="PartNumber"/>
                <DataGridTextColumn Header="{extensions:Localize Property_StockNumber_ColumnHeader}" Binding="{Binding StockNumber}" SortMemberPath="StockNumber"/>
                <DataGridTextColumn Header="{extensions:Localize Property_Material_ColumnHeader}" Binding="{Binding Material}" SortMemberPath="Material"/>
                <DataGridTextColumn Header="{extensions:Localize Property_Description_ColumnHeader}" Binding="{Binding Description}" SortMemberPath="Description"/>
                <DataGridTextColumn Header="{extensions:Localize Frame_ColumnLength}" Binding="{Binding LengthMm, StringFormat=F2}" SortMemberPath="LengthMm"/>
                <DataGridTextColumn Header="{extensions:Localize Property_Quantity_ColumnHeader}" Binding="{Binding Quantity}" SortMemberPath="Quantity"/>
                <DataGridTextColumn Header="{extensions:Localize Property_FileName_ColumnHeader}" Binding="{Binding FileName}" SortMemberPath="FileName"/>
                <DataGridTextColumn Header="{extensions:Localize Frame_ColumnOutputFile}" Binding="{Binding OutputFile}" SortMemberPath="OutputFile"/>
            </DataGrid.Columns>
        </DataGrid>

        <StatusBar Grid.Row="3" Style="{StaticResource BaseStatusBarStyle}">
            <StatusBarItem Style="{StaticResource BaseStatusBarItemStyle}">
                <TextBlock>
                    <Run Text="{extensions:Localize Text_Status}" FontWeight="Bold"/>
                    <Run x:Name="StatusTextBlock"/>
                </TextBlock>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</UserControl>
